{
  "schemaVersion": "1.0",
  "project": {
    "name": "Empréstimo pessoal — simulação e contratação",
    "code": "EMP-2026-01",
    "squad": "Squad Crédito PF",
    "owner": "Ana Souza (Analytics)",
    "devOwner": "Bruno Lima (Front-end)",
    "platform": "Web (desktop e mobile)",
    "domain": "https://www.exemplo.com.br/emprestimo",
    "method": "dataLayer",
    "tools": [
      "Google Tag Manager",
      "Google Analytics 4"
    ],
    "objective": "Entender onde as pessoas abandonam o funil de simulação até a contratação do empréstimo e quais valores/prazos são mais simulados.",
    "kpis": "Taxa de conversão simulação → contratação; abandono por etapa; ticket médio simulado.",
    "version": "1.0.0",
    "status": "Em homologação (QA)",
    "dueDate": "2026-12-15",
    "notes": "Não enviar dados pessoais (CPF, nome, e-mail, telefone) em nenhum parâmetro — LGPD."
  },
  "globalParams": [
    {
      "name": "page_type",
      "type": "string",
      "required": true,
      "example": "emprestimo_simulacao",
      "source": "Dinâmico - página/DOM",
      "description": "Tipo/template da página."
    },
    {
      "name": "user_logged",
      "type": "boolean",
      "required": true,
      "example": "true",
      "source": "Dinâmico - backend/API",
      "description": "Se a pessoa está autenticada."
    },
    {
      "name": "customer_segment",
      "type": "string",
      "required": false,
      "example": "varejo",
      "source": "Dinâmico - backend/API",
      "description": "Segmento do cliente (nunca dados pessoais)."
    }
  ],
  "screens": [
    {
      "id": "scr_simulacao",
      "name": "1. Simulação",
      "url": "/emprestimo/simular",
      "description": "Pessoa informa valor e prazo e clica em Simular.",
      "image": "data:image/svg+xml;base64,"
    },
    {
      "id": "scr_resultado",
      "name": "2. Resultado da simulação",
      "url": "/emprestimo/resultado",
      "description": "Exibe as ofertas calculadas. A pessoa escolhe uma oferta para contratar.",
      "image": "data:image/svg+xml;base64,"
    },
    {
      "id": "scr_sucesso",
      "name": "3. Contratação concluída",
      "url": "/emprestimo/sucesso",
      "description": "Confirmação após assinatura do contrato.",
      "image": "data:image/svg+xml;base64,"
    }
  ],
  "events": [
    {
      "id": "ev_1",
      "name": "loan_simulation_start",
      "status": "Em homologação (QA)",
      "priority": "Alta",
      "trigger": "Clique",
      "businessQuestion": "Quantas pessoas iniciam uma simulação e com quais valores/prazos?",
      "description": "Dispara ao clicar no botão \"Simular\", somente se o formulário for válido.",
      "screenId": "scr_simulacao",
      "marker": {
        "x": 21,
        "y": 52.5
      },
      "elementText": "Simular",
      "selector": "[data-analytics=\"btn-simular\"]",
      "isConversion": false,
      "params": [
        {
          "name": "loan_amount",
          "type": "number",
          "required": true,
          "example": "10000",
          "source": "Dinâmico - input do usuário",
          "description": "Valor solicitado, sem máscara."
        },
        {
          "name": "installments",
          "type": "number",
          "required": true,
          "example": "24",
          "source": "Dinâmico - input do usuário",
          "description": "Quantidade de parcelas."
        }
      ],
      "notes": ""
    },
    {
      "id": "ev_2",
      "name": "loan_offer_view",
      "status": "Em homologação (QA)",
      "priority": "Média",
      "trigger": "Visualização de elemento",
      "businessQuestion": "Quantas ofertas são exibidas por simulação?",
      "description": "Dispara uma vez quando a lista de ofertas termina de carregar.",
      "screenId": "scr_resultado",
      "marker": {
        "x": 50,
        "y": 24
      },
      "elementText": "Escolha sua oferta",
      "selector": "#lista-ofertas",
      "isConversion": false,
      "params": [
        {
          "name": "offers_count",
          "type": "number",
          "required": true,
          "example": "2",
          "source": "Dinâmico - backend/API",
          "description": "Quantidade de ofertas exibidas."
        }
      ],
      "notes": ""
    },
    {
      "id": "ev_3",
      "name": "loan_offer_select",
      "status": "Em homologação (QA)",
      "priority": "Alta",
      "trigger": "Clique",
      "businessQuestion": "Qual oferta (prazo/taxa) as pessoas escolhem?",
      "description": "Dispara ao clicar em \"Contratar esta oferta\" em qualquer card.",
      "screenId": "scr_resultado",
      "marker": {
        "x": 27.5,
        "y": 58
      },
      "elementText": "Contratar esta oferta",
      "selector": "[data-analytics=\"btn-contratar-oferta\"]",
      "isConversion": false,
      "params": [
        {
          "name": "offer_id",
          "type": "string",
          "required": true,
          "example": "oferta_a",
          "source": "Dinâmico - backend/API",
          "description": "Identificador da oferta."
        },
        {
          "name": "offer_position",
          "type": "number",
          "required": true,
          "example": "1",
          "source": "Dinâmico - página/DOM",
          "description": "Posição do card (1 = primeiro)."
        },
        {
          "name": "installments",
          "type": "number",
          "required": true,
          "example": "24",
          "source": "Dinâmico - backend/API",
          "description": "Parcelas da oferta."
        },
        {
          "name": "interest_rate",
          "type": "number",
          "required": true,
          "example": "1.89",
          "source": "Dinâmico - backend/API",
          "description": "Taxa mensal, ponto como separador."
        }
      ],
      "notes": ""
    },
    {
      "id": "ev_4",
      "name": "loan_contract_success",
      "status": "Em desenvolvimento",
      "priority": "Alta",
      "trigger": "Sucesso / conversão",
      "businessQuestion": "Quantas contratações acontecem e de que valor?",
      "description": "Dispara quando a tela de sucesso é carregada após a confirmação do backend. Não disparar em recarregamento da página.",
      "screenId": "scr_sucesso",
      "marker": {
        "x": 50,
        "y": 36
      },
      "elementText": "Pronto! Empréstimo contratado",
      "selector": "",
      "isConversion": true,
      "params": [
        {
          "name": "value",
          "type": "currency",
          "required": true,
          "example": "10000.00",
          "source": "Dinâmico - backend/API",
          "description": "Valor contratado."
        },
        {
          "name": "currency",
          "type": "string",
          "required": true,
          "example": "BRL",
          "source": "Fixo (valor constante)",
          "description": "Moeda (ISO 4217)."
        },
        {
          "name": "transaction_id",
          "type": "string",
          "required": true,
          "example": "ctr_8f2a91",
          "source": "Dinâmico - backend/API",
          "description": "ID interno do contrato (não é dado pessoal)."
        }
      ],
      "notes": "Marcar como evento-chave (conversão) no GA4."
    }
  ],
  "changelog": [
    {
      "date": "2026-11-04",
      "author": "Ana Souza",
      "change": "Criação do plano."
    }
  ]
}